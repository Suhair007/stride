generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum MembershipRole {
  ORG_ADMIN
  TENANT_ADMIN
  MEMBER
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Organization {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  createdAt   DateTime     @default(now())
  tenants     Tenant[]
  memberships Membership[]
}

model Tenant {
  id             String        @id @default(cuid())
  organizationId String
  name           String
  slug           String
  createdAt      DateTime      @default(now())
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships    Membership[]
  boards         Board[]
  tasks          Task[]
  activities     ActivityLog[]

  @@unique([organizationId, slug])
  @@unique([id, organizationId])
  @@index([organizationId])
}

model User {
  id           String       @id @default(cuid())
  name         String
  email        String       @unique
  passwordHash String
  avatarColor  String       @default("#8c78e8")
  createdAt    DateTime     @default(now())
  memberships  Membership[]
  assignedTasks Task[]      @relation("TaskAssignee")
  activities   ActivityLog[]
}

model Membership {
  id             String         @id @default(cuid())
  userId         String
  organizationId String
  tenantId       String?
  scopeKey       String
  role           MembershipRole @default(MEMBER)
  createdAt      DateTime       @default(now())
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tenant         Tenant?        @relation(fields: [tenantId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([userId, organizationId, scopeKey])
  @@index([tenantId, userId])
  @@index([organizationId, userId])
}

model Board {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  columns   Column[]
  tasks     Task[]

  @@unique([id, tenantId])
  @@index([tenantId])
}

model Column {
  id        String   @id @default(cuid())
  tenantId  String
  boardId   String
  name      String
  color     String   @default("#9a93a8")
  position  Int
  createdAt DateTime @default(now())
  board     Board    @relation(fields: [boardId, tenantId], references: [id, tenantId], onDelete: Cascade)
  tasks     Task[]

  @@unique([id, boardId, tenantId])
  @@index([tenantId, boardId, position])
}

model Task {
  id          String       @id @default(cuid())
  tenantId    String
  boardId     String
  columnId    String
  title       String
  description String       @default("")
  priority    TaskPriority @default(MEDIUM)
  position    Int
  version     Int          @default(1)
  dueDate     DateTime?
  assigneeId  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  board       Board        @relation(fields: [boardId, tenantId], references: [id, tenantId], onDelete: Cascade)
  column      Column       @relation(fields: [columnId, boardId, tenantId], references: [id, boardId, tenantId], onDelete: Cascade)
  assignee    User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  activities  ActivityLog[]

  @@index([tenantId, boardId, columnId, position])
  @@index([assigneeId])
}

model ActivityLog {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  taskId    String?
  action    String
  detail    String
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
}
