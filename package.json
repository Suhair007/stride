{
  "name": "stride-kanban",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web,ai -c blue,green,magenta \"npm:dev:api\" \"npm:dev:web\" \"npm:dev:ai\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite --host 0.0.0.0",
    "dev:ai": "python -m uvicorn app.main:app --app-dir ai_service --reload --host 127.0.0.1 --port 8000",
    "test:ai": "python -m unittest discover -s ai_service/tests -t ai_service -v",
    "test:api": "node --test server/*.test.js",
    "build": "vite build",
    "start": "node server/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "prisma": "^6.19.0",
    "vite": "^6.4.1"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
